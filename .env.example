# Nombres de variables y credenciales del proyecto. SIN valores.
# Los valores viven en credenciales de n8n Cloud, secretos de ElevenLabs y secretos de GitHub Actions; nunca en el repo.

# n8n · credencial "CNI Telegram bot" (Telegram API)
TELEGRAM_BOT_TOKEN=
# n8n · credencial "CNI Anthropic (x-api-key)" (Header Auth, dominio permitido api.anthropic.com)
ANTHROPIC_API_KEY=
# n8n · credencial "CNI Voz (x-cni-voz)" y secreto "cni_voz_n8n" en ElevenLabs (mismo valor)
N8N_VOZ_WEBHOOK_SECRET=
# n8n · credencial "CNI Export (x-cni-export)" y secreto de Actions N8N_EXPORT_SECRET (mismo valor)
N8N_EXPORT_SECRET=
# Secreto de Actions: https://<instancia>.app.n8n.cloud/webhook/cni-export
N8N_EXPORT_URL=
# Identificador público del agente de ElevenLabs (va en web/index.html; no es secreto)
ELEVENLABS_AGENT_ID=
