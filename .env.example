# Nombres de variables y credenciales del proyecto. SIN valores.
# En este proyecto los valores viven en las credenciales de n8n Cloud o en ElevenLabs, nunca en el repo.

# Telegram (credencial "Telegram API" en n8n)
TELEGRAM_BOT_TOKEN=

# Anthropic (credencial "Anthropic API" en n8n)
ANTHROPIC_API_KEY=

# Webhook de voz: secreto compartido entre la herramienta de servidor de ElevenLabs y n8n (Header Auth)
N8N_VOZ_WEBHOOK_SECRET=

# Identificador público del agente de ElevenLabs (puede ir en el HTML; no es un secreto)
ELEVENLABS_AGENT_ID=
